#!name=XCamera 广告净化 (Loon)
#!desc=移植自 ZenMoFeiShi 的 QX XCamera 广告净化规则；针对开屏、插屏、信息流和 RTB 广告
#!author=ZenMoFeiShi (original); Loon adaptation
#!homepage=https://github.com/zkjjs/loonjs

[URL Rewrite]
^https?:\/\/ad\.xhey\.top\/next\/(?:app\/adx\/|promote\/operation\/appstart\/adx\/|ad\/event\/track\/).* reject
^https?:\/\/39\.108\.85\.131\/next\/(?:ios\/config\/cache|promote\/operation\/config\/get\/cache)(?:\?.*)?$ reject
^https?:\/\/sdk\.1rtb\.net\/sdk\/(?:config\/v2a|req_ad)(?:\?.*)?$ reject
^https?:\/\/adx-strategy-api-cn\.statisticslinks\.com\/sdk\/pl_strategy(?:\?.*)?$ reject
^https?:\/\/adx-micro\.statisticslinks\.com\/http_bid(?:\?.*)?$ reject
^https?:\/\/da\.statisticslinks\.com\/v1\/open\/da(?:\?.*)?$ reject
^https?:\/\/tk\.statisticslinks\.com\/v2\/open\/a_tk(?:\?.*)?$ reject
^https?:\/\/sdkquic\.e\.qq\.com\/launch(?:\?.*)?$ reject
^https?:\/\/als\.baidu\.com\/clog\/glog(?:\?.*)?$ reject

[Script]
http-response ^https?:\/\/jt-sdk-ios\.oss-cn-beijing\.aliyuncs\.com\/iOSConfig\.txt(?:\?.*)?$ script-path=https://raw.githubusercontent.com/zkjjs/loonjs/main/xhey-ad-clean.js, requires-body=true, timeout=20, tag=XCamera广告配置净化

[MITM]
hostname = ad.xhey.top, 39.108.85.131, sdk.1rtb.net, adx-strategy-api-cn.statisticslinks.com, adx-micro.statisticslinks.com, da.statisticslinks.com, tk.statisticslinks.com, sdkquic.e.qq.com, als.baidu.com, jt-sdk-ios.oss-cn-beijing.aliyuncs.com
