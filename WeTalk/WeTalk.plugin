[Script]
http-request ^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/zkjjs/loonjs/main/WeTalk/WeTalk.js, requires-body=false, timeout=30, tag=WeTalk抓取账号
cron "20 8,20 * * *" script-path=https://raw.githubusercontent.com/zkjjs/loonjs/main/WeTalk/WeTalk.js, timeout=300, tag=WeTalk签到

[MITM]
hostname = api.wetalkapp.com
