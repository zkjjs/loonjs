#!name=DNS 防泄漏增强（保留 UDP）
#!desc=配合阿里云默认 DNS 主配置：常用国外域名使用 Cloudflare DoH，拦截规则可见的 53/853 外发；不修改 STUN、IPv6 或 Tello 通话路由。添加时选择可用代理策略。需开启主配置 hijack-dns = *:53，关闭包含系统 DNS 与查询回落，DoH 模式选择 Rule。不能保证拦截绕过 TUN、自带 DoH 或节点端 DNS。
#!author=zkjjs
#!tag=DNS
#!date=2026-10-14
#!homepage=https://github.com/zkjjs/loonjs

# Original rule-list reference: 非正常人类研究中心
# https://kelee.one/Tool/Loon/Lpx/Prevent_DNS_Leaks.lpx
# Independently extended; not an official upstream version.
# REQUIRED in main config: AliDNS DoH + hijack-dns = *:53.
# REQUIRED in UI: system DNS OFF; query fallback OFF; DoH mode Rule.
# Do NOT enable the original plugin alongside this replacement.
# Select a working proxy policy when adding this plugin (PROXY below).
# No global doh-server here: plugin DNS servers are appended, not replacements.
# This plugin cannot enforce main-config switches or override higher-priority rules.
# Blocking 853 intentionally disallows application DoT/DoQ; use DoH instead.
# DNS handling is limited to traffic visible to Loon; no zero-leak guarantee.
# Keep disable-stun = false in main config. No global UDP disable is used.
# Tello real-ip and routing are preserved by leaving them to the main config.

[Rule]
# Best-effort fallback guards AFTER DNS hijacking; earlier/local rules may win.
DEST-PORT,53,REJECT
DEST-PORT,853,REJECT
# Pin encrypted DNS transports without adding parallel default resolvers.
IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
IP-CIDR,223.6.6.6/32,DIRECT,no-resolve
IP-CIDR,1.1.1.1/32,PROXY,no-resolve
IP-CIDR,1.0.0.1/32,PROXY,no-resolve
DOMAIN,dns.alidns.com,DIRECT
DOMAIN,cloudflare-dns.com,PROXY
DOMAIN-SUFFIX,astrill.com,PROXY
DOMAIN-SUFFIX,astrill.org,PROXY
DOMAIN-SUFFIX,browserleaks.com,PROXY
DOMAIN-SUFFIX,browserleaks.org,PROXY
DOMAIN-SUFFIX,dnscheck.tools,PROXY
DOMAIN-SUFFIX,dnsleak.asn247.net,PROXY
DOMAIN-SUFFIX,dnsleak.com,PROXY
DOMAIN-SUFFIX,dnsleaktest.com,PROXY
DOMAIN-SUFFIX,expressvpn.com,PROXY
DOMAIN-SUFFIX,ipapi.co,PROXY
DOMAIN-SUFFIX,ipleak.net,PROXY
DOMAIN-SUFFIX,nordvpn.com,PROXY
DOMAIN-SUFFIX,perfect-privacy.com,PROXY
DOMAIN-SUFFIX,pixelscan.net,PROXY
DOMAIN-SUFFIX,surfshark.com,PROXY
DOMAIN-SUFFIX,surfsharkdns.com,PROXY
DOMAIN-SUFFIX,vpnunlimited.com,PROXY
DOMAIN-SUFFIX,whoer.net,PROXY
DOMAIN-SUFFIX,whrq.net,PROXY
DOMAIN,ipv4.ping0.cc,PROXY
DOMAIN,ipv6.ping0.cc,PROXY
DOMAIN,ip-scan.adspower.net,PROXY

[Host]
# Explicit foreign-domain DNS policy, including both apex and subdomains.
# Unlisted domains retain main-config default AliDNS. Test coverage is not global privacy.
3gppnetwork.org = server:https://1.1.1.1/dns-query
*.3gppnetwork.org = server:https://1.1.1.1/dns-query
akamaized.net = server:https://1.1.1.1/dns-query
*.akamaized.net = server:https://1.1.1.1/dns-query
amazon.co.jp = server:https://1.1.1.1/dns-query
*.amazon.co.jp = server:https://1.1.1.1/dns-query
amazon.com = server:https://1.1.1.1/dns-query
